# ─────────────────────────────────────────────────────────────────────────────
# ResilienceOS Environment Configuration
# Copy this file to .env and fill in your values before running docker-compose up
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Post-Mortem Generation ──────────────────────────────────────────────
# Your Anthropic API key for Claude-powered post-mortem generation.
# Without this, the system uses a high-quality stub generator that still
# produces realistic post-mortems from experiment data.
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# In Docker Compose, the hostname is "postgres" (the service name).
DATABASE_URL=postgresql://resilience:resilience@postgres:5432/resilienceos

# ── Redis ─────────────────────────────────────────────────────────────────
# Redis connection URL.
# In Docker Compose, the hostname is "redis" (the service name).
REDIS_URL=redis://redis:6380/0

# ── Service Discovery URLs ─────────────────────────────────────────────────
# Internal Docker Compose service URLs.
# Only change these if you're running services outside of Docker Compose.
API_GATEWAY_URL=http://api-gateway:8000
USER_SERVICE_URL=http://user-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
ORDER_SERVICE_URL=http://order-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004
CHAOS_AGENT_URL=http://chaos-agent:8010

# ── Frontend ───────────────────────────────────────────────────────────────
# URLs used by the React frontend to reach the control plane API.
# For local Docker Compose, these point to localhost.
# For a deployed environment, change to your public hostname.
REACT_APP_API_URL=http://localhost:19000
REACT_APP_WS_URL=ws://localhost:19000
REACT_APP_GRAFANA_URL=http://localhost:13030

# ── Grafana ────────────────────────────────────────────────────────────────
# Anonymous auth is enabled by default for demo convenience.
# In production, set GF_AUTH_ANONYMOUS_ENABLED=false and configure proper auth.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_SECURITY_ALLOW_EMBEDDING=true
GF_DEFAULT_THEME=dark
